{
  "name": "tripboogie",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/prepare-preview.mjs && next dev --hostname 127.0.0.1 --port 5173",
    "build": "node scripts/prepare-preview.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --test app/server/integration.test.mjs",
    "native:build": "node scripts/prepare-preview.mjs && node scripts/native-prepare.mjs && vite build --config native/vite.config.ts",
    "native:sync": "npm run native:build && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "test:native": "node --test native/native.test.mjs",
    "native:android:build": "node scripts/native-build.mjs android",
    "native:ios:build": "node scripts/native-build.mjs ios",
    "native:auth:check": "node scripts/native-auth-config.mjs --check",
    "native:auth:apply": "node scripts/native-auth-config.mjs --apply",
    "assets:generate": "swift scripts/native-assets.swift && npm run assets:optimize",
    "test:navigation": "node --test app/navigation.test.mjs",
    "test:theme": "node --test app/theme.test.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "test:performance": "node --test app/performance.test.mjs",
    "benchmark:performance": "node scripts/benchmark-performance.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/share": "7.0.4",
    "@date-fns/tz": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "6.14.0",
    "next": "16.3.4",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "postcss": "8.5.23",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "sharp": "0.35.4"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
