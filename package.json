{
  "name": "tripboogie",
  "version": "0.1.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --test app/server/integration.test.mjs",
    "native:build": "node scripts/native-prepare.mjs && vite build --config native/vite.config.ts",
    "native:sync": "npm run native:build && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "test:native": "node --test native/native.test.mjs",
    "native:android:build": "node scripts/native-build.mjs android",
    "native:ios:build": "node scripts/native-build.mjs ios",
    "native:auth:check": "node scripts/native-auth-config.mjs --check",
    "native:auth:apply": "node scripts/native-auth-config.mjs --apply",
    "assets:generate": "swift scripts/native-assets.swift",
    "test:navigation": "node --test app/navigation.test.mjs",
    "test:theme": "node --test app/theme.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/share": "7.0.4",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "6.14.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
